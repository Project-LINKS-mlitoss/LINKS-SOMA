{
  "name": "geocoding-app",
  "productName": "LINKS SOMA ジオコーディング",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "build:main": "tsc --project electron/tsconfig.json",
    "build:renderer": "tsc -b && vite build",
    "build": "npm run build:main && npm run build:renderer",
    "electron:dev": "npm run build && electron ./electron/dist/main.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish=never",
    "dist:mac": "npm run build && electron-builder --mac --publish=never",
    "dist:win": "npm run build && electron-builder --win --publish=never",
    "e2e": "npm run build && playwright test",
    "e2e:help": "playwright test --list"
  },
  "dependencies": {
    "@digital-go-jp/abr-geocoder": "2.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@fluentui/react-components": "^9.56.2",
    "@fluentui/react-icons": "^2.0.266",
    "@fluentui/react-tabs": "^9.6.2",
    "@griffel/react": "^1.5.27",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/xlsx": "^0.0.36",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "33.2.1",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "xlsx": "^0.18.5"
  },
  "volta": {
    "node": "22.11.0",
    "yarn": "4.5.3"
  },
  "build": {
    "appId": "jp.go.mlit.geocoding.soma.geocoding",
    "productName": "LINKS SOMA ジオコーディング",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/dist/**/*",
      "dist/**/*"
    ],
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "src/data/都道府県コード及び市区町村コード.xls",
        "to": "data/都道府県コード及び市区町村コード.xls",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "dist/icon.icns",
      "artifactName": "links-soma-geocoding.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "dist/icon.ico",
      "artifactName": "links-soma-geocoding.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "dist/icon.png"
    }
  },
  "main": "electron/dist/main.js"
}
